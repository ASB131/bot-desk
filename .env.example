# Token from the Discord Developer Portal → your application → Bot.
DISCORD_TOKEN=

# General Information → Application ID (invite link works even before the bot connects).
DISCORD_APPLICATION_ID=

# General Information → Public Key (optional; kept for reference).
DISCORD_PUBLIC_KEY=

# Password for the web panel. Pick a long one.
PANEL_PASSWORD=

# Port on this machine. The panel opens at http://localhost:23435
PORT=23435

# Used until you change the timezone on the Settings page.
DEFAULT_TIMEZONE=UTC
